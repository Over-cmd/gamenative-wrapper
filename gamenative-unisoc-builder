FROM ghcr.io/termux/package-builder:latest 

USER root 

### Instalar dependencias esenciales de compilación y Python

RUN apt-get update && 
apt-get install -y --no-install-recommends ninja-build git && 
pip3 install --break-system-packages --ignore-installed --no-cache-dir meson ninja mako pyyaml packaging 

### Clonar y preparar el repositorio objetivo

RUN git clone --depth 1 https://github.com/Over-cmd/gamenative-wrapper.git /root/gamenative-wrapper 

### Descarga de Sysroots para ambas arquitecturas (aarch64 y arm) desde los servidores de Termux

RUN mkdir -p /tmp/sysroot-aarch64 /tmp/sysroot-arm && 
TERMUX_REPO="https://packages-cf.termux.dev/apt/termux-main" && 
PACKAGES="libdrm libandroid-shmem libxcb libx11 libxshmfence libxext libxrandr libxrender xorgproto libxau libxdmcp" && 
\ 

### Configuración de dependencias de 64 bits (aarch64)

cd /tmp/sysroot-aarch64 && 
curl -s "${TERMUX_REPO}/dists/stable/main/binary-aarch64/Packages" > Packages && 
for pkg in $PACKAGES; do 
pkg_path=(awk -v p="Package: pkg" '$0==p{flag=1} flag && /^Filename:/{print $2; exit}' Packages) && 
curl -L -O "
𝑇𝐸𝑅𝑀𝑈𝑋𝑅𝐸𝑃𝑂

/
{pkg_path}"; 
done && 
for f in *.deb; do dpkg-deb -x "$f" /; done && 
\ 

### Configuración de dependencias de 32 bits (arm)

cd /tmp/sysroot-arm && 
curl -s "${TERMUX_REPO}/dists/stable/main/binary-arm/Packages" > Packages && 
for pkg in $PACKAGES; do 
pkg_path=(awk -v p="Package: pkg" '$0==p{flag=1} flag && /^Filename:/{print $2; exit}' Packages) && 
curl -L -O "
𝑇𝐸𝑅𝑀𝑈𝑋𝑅𝐸𝑃𝑂

/
{pkg_path}"; 
done && 
mkdir -p /tmp/extracted-arm && 
for f in *.deb; do dpkg-deb -x "$f" /tmp/extracted-arm; done && 
mkdir -p /data/data/com.termux/files/usr/lib/arm-linux-androideabi && 
cp -r /tmp/extracted-arm/data/data/com.termux/files/usr/include/* /data/data/com.termux/files/usr/include/ 2>/dev/null || true && 
cp -r /tmp/extracted-arm/data/data/com.termux/files/usr/lib/* /data/data/com.termux/files/usr/lib/arm-linux-androideabi/ 2>/dev/null || true && 

rm -rf /tmp/sysroot-aarch64 /tmp/sysroot-arm /tmp/extracted-arm 

### Configuración de los toolchains del Android NDK

RUN NDK_DIR=$(find /home/builder/lib -maxdepth 2 -name "android-ndk*" 2>/dev/null | head -n 1) && 
NDK_BIN="${NDK_DIR}/toolchains/llvm/prebuilt/linux-x86_64/bin" && 
mkdir -p /root/build-config && 
\ 

# Archivo de configuración cruzada de Meson para 64 BITS (aarch64)

cat << EOF > /root/build-config/cross_aarch64.txt

[binaries]
c = '${NDK_BIN}/aarch64-linux-android30-clang'
cpp = '${NDK_BIN}/aarch64-linux-android30-clang++'
ar = '${NDK_BIN}/llvm-ar'
strip = '${NDK_BIN}/llvm-strip'
pkg-config = 'pkg-config' 

[constants]
termux_dir = '/data/data/com.termux/files/usr' 

[properties]
pkg_config_libdir = termux_dir + '/lib/pkgconfig:' + termux_dir + '/share/pkgconfig' 

[built-in options]
c_args = ['-D__TERMUX__', '-D__USE_GNU', '-U__ANDROID__', '-I' + termux_dir + '/include', '-include', 'fcntl.h', '-include', 'unistd.h']
cpp_args = ['-D__TERMUX__', '-D__USE_GNU', '-U__ANDROID__', '-I' + termux_dir + '/include', '-include', 'fcntl.h', '-include', 'unistd.h']
c_link_args = ['-L' + termux_dir + '/lib', '-landroid-shmem']
cpp_link_args = ['-L' + termux_dir + '/lib', '-landroid-shmem'] 

[host_machine]
system = 'android'
cpu_family = 'aarch64'
cpu = 'armv8-a'
endian = 'little'
EOF
&& \ 

# Archivo de configuración cruzada de Meson para 32 BITS (arm)

cat << EOF > /root/build-config/cross_arm.txt

[binaries]
c = '${NDK_BIN}/armv7a-linux-androideabi30-clang'
cpp = '${NDK_BIN}/armv7a-linux-androideabi30-clang++'
ar = '${NDK_BIN}/llvm-ar'
strip = '${NDK_BIN}/llvm-strip'
pkg-config = 'pkg-config' 

[constants]
termux_dir = '/data/data/com.termux/files/usr' 

[properties]
pkg_config_libdir = termux_dir + '/lib/arm-linux-androideabi/pkgconfig:' + termux_dir + '/share/pkgconfig' 

[built-in options]
c_args = ['-D__TERMUX__', '-D__USE_GNU', '-U__ANDROID__', '-I' + termux_dir + '/include', '-include', 'fcntl.h', '-include', 'unistd.h', '-march=armv7-a', '-mfpu=neon']
cpp_args = ['-D__TERMUX__', '-D__USE_GNU', '-U__ANDROID__', '-I' + termux_dir + '/include', '-include', 'fcntl.h', '-include', 'unistd.h', '-march=armv7-a', '-mfpu=neon']
c_link_args = ['-L' + termux_dir + '/lib/arm-linux-androideabi', '-landroid-shmem']
cpp_link_args = ['-L' + termux_dir + '/lib/arm-linux-androideabi', '-landroid-shmem'] 

[host_machine]
system = 'android'
cpu_family = 'arm'
cpu = 'armv7-a'
endian = 'little'
EOF 

### Inyectar el script de compilación para gamenative-unisoc-builder

COPY build.sh /root/build.sh
RUN chmod +x /root/build.sh 

WORKDIR /root/gamenative-wrapper
