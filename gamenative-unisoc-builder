FROM ubuntu:22.04

# Evitar preguntas interactivas molestas durante la instalación de paquetes
ENV DEBIAN_FRONTEND=noninteractive

# Instalar herramientas esenciales de Linux y Python modernas para compilar Mesa 25
RUN apt-get update && apt-get install -y \
    build-essential ninja-build pkg-config zstd curl unzip bison flex cmake git \
    libdrm-dev python3 python3-pip && \
    apt-get clean

# Actualizar y configurar Meson y las librerías de parseo de sombreadores (Mako)
RUN pip3 install --upgrade pip && \
    pip3 install mako PyYAML meson ninja packaging

# Descargar e instalar de forma limpia el Android NDK estable para la scene
ENV NDK_VERSION=r25c
RUN curl -L "https://google.com{NDK_VERSION}-linux.zip" -o ndk.zip && \
    unzip -q ndk.zip -d /opt/ && \
    rm -f ndk.zip

ENV NDK_ROOT=/opt/android-ndk-${NDK_VERSION}

# Generar el archivo de configuración cruzada usando comandos echo limpios en líneas individuales inofensivas
RUN mkdir -p /root/build-config
RUN echo '[binaries]' > /root/build-config/cross_file.txt
RUN echo "c = '/opt/android-ndk-r25c/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android30-clang'" >> /root/build-config/cross_file.txt
RUN echo "cpp = '/opt/android-ndk-r25c/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android30-clang++'" >> /root/build-config/cross_file.txt
RUN echo "ar = '/opt/android-ndk-r25c/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar'" >> /root/build-config/cross_file.txt
RUN echo "strip = '/opt/android-ndk-r25c/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip'" >> /root/build-config/cross_file.txt
RUN echo "pkg-config = '/usr/bin/pkg-config'" >> /root/build-config/cross_file.txt
RUN echo "cmake = '/usr/bin/cmake'" >> /root/build-config/cross_file.txt
RUN echo '[properties]' >> /root/build-config/cross_file.txt
RUN echo 'needs_exe_wrapper = true' >> /root/build-config/cross_file.txt
RUN echo '[host_machine]' >> /root/build-config/cross_file.txt
RUN echo "system = 'android'" >> /root/build-config/cross_file.txt
RUN echo "cpu_family = 'aarch64'" >> /root/build-config/cross_file.txt
RUN echo "cpu = 'armv8-a'" >> /root/build-config/cross_file.txt
RUN echo "endian = 'little'" >> /root/build-config/cross_file.txt

# Definir el directorio de trabajo del contenedor
WORKDIR /workspace

# Comando maestro de entrada: Configura Mesa sin red y compila directamente con Ninja en local
ENTRYPOINT ["/bin/bash", "-c", "\
    meson setup $1 --cross-file /root/build-config/cross_file.txt -Dbuildtype=release -Dplatforms=android -Dandroid-stub=true -Dvulkan-drivers=wrapper -Dgallium-drivers= -Dopengl=false -Dgbm=disabled -Degl=disabled -Dgles1=disabled -Dgles2=disabled -Dllvm=disabled -Dzstd=disabled -Dxmlconfig=disabled && \
    meson compile -C $1\
"]
