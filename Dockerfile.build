# ==========================================
# STAGE 1: Entorno de compilación base con NDK
# ==========================================
FROM --platform=linux/amd64 ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_NDK_HOME=/opt/android-ndk

# Instalar dependencias esenciales de compilación para Mesa 3D y descargas seguras
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    python3-setuptools \
    ninja-build \
    bison \
    flex \
    m4 \
    pkg-config \
    unzip \
    git \
    curl \
    glslang-tools \
    && rm -rf /var/lib/apt/lists/*

# Instalar Meson actualizado vía pip
RUN pip3 install meson

# Descarga robusta usando curl con reintentos para evitar archivos ZIP corruptos
RUN mkdir -p /opt \
    && curl -L --retry 5 --retry-delay 2 https://google.com -o /tmp/ndk.zip \
    && unzip -q /tmp/ndk.zip -d /opt \
    && mv /opt/android-ndk-r26b ${ANDROID_NDK_HOME} \
    && rm /tmp/ndk.zip

# Cambiar al directorio de trabajo y clonar el Mesa personalizado
WORKDIR /workspace
RUN git clone --depth 1 https://github.com .

# Copiar tus archivos de configuración cruzada locales (android-32.toml y android-64.toml)
COPY android-32.toml android-64.toml ./

# ==========================================
# STAGE 2: Compilación de 32 Bits (armeabi-v7a)
# ==========================================
FROM builder AS build-32
RUN meson setup build-32 \
    --cross-file android-32.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dgallium-drivers=zink,swrast \
    -Dvulkan-drivers=panfrost \
    && ninja -C build-32/

# ==========================================
# STAGE 3: Compilación de 64 Bits (arm64-v8a)
# ==========================================
FROM builder AS build-64
RUN meson setup build-64 \
    --cross-file android-64.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dgallium-drivers=zink,swrast \
    -Dvulkan-drivers=panfrost \
    && ninja -C build-64/

# ==========================================
# STAGE 4: Empaquetado final para Bannerlator
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

# Crear la jerarquía exacta que lee el Wrapper Version Manager de Bannerlator
RUN mkdir -p panvk-package/lib/armeabi-v7a \
    && mkdir -p panvk-package/lib/arm64-v8a

# Copiar las librerías binarias nativas de PanVK generadas por la compilación de Mesa
COPY --from=build-32 /workspace/build-32/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-package/lib/armeabi-v7a/libvulkan_wrapper.so
COPY --from=build-64 /workspace/build-64/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-package/lib/arm64-v8a/libvulkan_wrapper.so

# Escribir el manifiesto wrappers.json optimizado para Unisoc T618 (Mali-G52 MP2)
RUN echo '[{\
  "id": "panvk-t618-mali-g52",\
  "name": "Unisoc T618 Mali-G52 PanVK",\
  "description": "Driver Vulkan PanVK personalizado optimizado para procesadores Unisoc Tiger T618 y GPUs ARM Mali-G52 MP2 bajo el entorno Bannerlator.",\
  "author": "funnymdzz / Over-cmd",\
  "version": "25.0.0-t618",\
  "gpuTargets": ["mali"],\
  "features": ["panvk_android", "vulkan_1_1"],\
  "type": "icd_wrapper"\
}]' > ./panvk-package/wrappers.json

# Comprimir la carpeta en el formato nativo estándar tar.xz que lee Bannerlator
RUN cd panvk-package && tar -cJf ../panvk-mali-bannerlator.tar.xz lib/ wrappers.json

# Mantenemos una copia estructurada accesible para la exportación directa de Buildx
RUN cp -r panvk-package ../ && cp ../panvk-mali-bannerlator.tar.xz /
