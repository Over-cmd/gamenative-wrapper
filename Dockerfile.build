# ==========================================
# STAGE 1: Entorno de compilación base con NDK
# ==========================================
FROM --platform=linux/amd64 ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_NDK_HOME=/opt/android-ndk

# Instalar dependencias esenciales de compilación para Mesa 3D
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    python3-setuptools \
    ninja-build \
    bison \
    flex \
    m4 \
    pkg-config \
    unzip \
    git \
    glslang-tools \
    && rm -rf /var/lib/apt/lists/*
